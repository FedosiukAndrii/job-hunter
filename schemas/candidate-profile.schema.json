{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localhost/job-hunter/schemas/candidate-profile-v1.json",
  "title": "Job Hunter Candidate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetTitles",
    "skills",
    "rolePreferences",
    "scoring"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "targetTitles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "rolePreferences": {
      "$ref": "#/$defs/rolePreferences"
    },
    "languages": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "preferredDomains": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "salary": {
      "$ref": "#/$defs/salary"
    },
    "excludedEmployers": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "excludedKeywords": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "supplementalCvPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "enum": [
            "core",
            "related"
          ],
          "default": "related"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "yearsExperience": {
          "type": "number",
          "minimum": 0,
          "maximum": 80
        },
        "aliases": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "evidence": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "rolePreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seniorities": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "senioritySelectionRules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/senioritySelectionRule"
          }
        },
        "locations": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "remotePolicy": {
          "enum": [
            "any",
            "remoteOnly",
            "remoteOrHybrid",
            "preferRemote",
            "onSiteOnly"
          ],
          "default": "any"
        },
        "employmentTypes": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "enum": [
              "unknown",
              "fullTime",
              "partTime",
              "contract",
              "temporary",
              "internship"
            ]
          }
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "minimumLevel": {
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "C2",
            "Native"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "senioritySelectionRule": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "seniority"
          ],
          "not": {
            "required": [
              "minimumRequiredExperienceYears"
            ]
          }
        },
        {
          "required": [
            "minimumRequiredExperienceYears"
          ],
          "not": {
            "required": [
              "seniority"
            ]
          }
        }
      ],
      "properties": {
        "seniority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requiredAnyKeywords": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "minimumRequiredExperienceYears": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "minimumRequiredExperienceYears"
            ]
          },
          "then": {
            "not": {
              "required": [
                "requiredAnyKeywords"
              ]
            }
          }
        }
      ]
    },
    "salary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "currency",
        "period"
      ],
      "properties": {
        "minimum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "enum": [
            "hour",
            "month",
            "year"
          ]
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulesOnlyThreshold",
        "rulesAndAiThreshold",
        "weights"
      ],
      "properties": {
        "rulesOnlyThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rulesAndAiThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coreSkills",
            "seniority",
            "relatedStack",
            "roleResponsibilities",
            "locationLanguage",
            "domain",
            "compensation"
          ],
          "properties": {
            "coreSkills": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "seniority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "relatedStack": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "roleResponsibilities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "locationLanguage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "domain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "compensation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}
