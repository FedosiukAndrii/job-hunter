{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localhost/job-hunter/schemas/candidate-profile-v2.json",
  "title": "Job Hunter Candidate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetTitles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "targetTitles": {
      "$ref": "#/$defs/requiredStrings"
    },
    "requiredSkills": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "hardFilters": {
      "$ref": "#/$defs/hardFilters"
    },
    "aiPreferences": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "supplementalCvPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "$defs": {
    "requiredStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "hardFilters": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "locations": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "remotePolicy": {
          "enum": [
            "any",
            "remoteOnly",
            "remoteOrHybrid",
            "onSiteOnly"
          ],
          "default": "any"
        },
        "excludedEmployers": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "excludedKeywords": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    }
  }
}
