{
  "Worker": {
    "SchedulerTickSeconds": 60,
    "ShutdownTimeoutSeconds": 30,
    "MaximumConcurrentSources": 2,
    "MaximumSubscriptionsPerTick": 16,
    "SourceLeaseSeconds": 300,
    "NotificationDispatchIntervalSeconds": 1,
    "NotificationBatchSize": 20,
    "NotificationLeaseSeconds": 120,
    "NotificationMaximumAttempts": 5,
    "NotificationMaximumRetrySeconds": 1800
  },
  "Storage": {
    "DatabaseFileName": "job-hunter.db",
    "BusyTimeoutSeconds": 5
  },
  "Retention": {
    "Enabled": true,
    "OperationalRecordDays": 30,
    "CleanupIntervalHours": 24
  },
  "Profile": {
    "MaximumProfileBytes": 131072,
    "MaximumCvBytes": 262144
  },
  "Sources": {
    "Dou": {
      "Enabled": true,
      "FeedUrl": "https://jobs.dou.ua/vacancies/feeds/?category=.NET",
      "DefaultIntervalMinutes": 12,
      "RequestTimeoutSeconds": 30,
      "MaximumResponseBytes": 2097152,
      "MaximumItems": 200,
      "MaximumDescriptionCharacters": 50000,
      "DetailEnrichmentEnabled": false,
      "DetailMinimumIntervalSeconds": 2
    },
    "LinkedInJobSpy": {
      "Enabled": false,
      "ExperimentalAcknowledged": false,
      "Endpoint": "http://127.0.0.1:8080/",
      "SearchTerm": ".NET",
      "MinimumIntervalMinutes": 60,
      "RequestTimeoutSeconds": 45,
      "MaximumResults": 50,
      "MaximumResponseBytes": 2097152,
      "BlockedBackoffHours": 24
    }
  },
  "AI": {
    "Enabled": false,
    "Provider": "copilot",
    "AnalysisTimeoutSeconds": 60,
    "MinimumConfidence": 0.65,
    "TransientFailureRetryMinutes": 60,
    "Copilot": {
      "Model": "gpt-5.6-luna",
      "FailStartupWhenModelUnavailable": true,
      "MaximumInputCharacters": 48000,
      "MaximumOutputCharacters": 4000,
      "MaximumConcurrency": 1,
      "QueueCapacity": 32,
      "MaximumTransientRetries": 1,
      "TransientRetryDelaySeconds": 2
    }
  },
  "Telegram": {
    "Enabled": false,
    "DebugMode": false,
    "DestinationId": "telegram-primary",
    "PerChatMessagesPerSecond": 1,
    "RequestTimeoutSeconds": 30,
    "TransientRetrySeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
